# Copy to .env for local development. Never commit the real .env.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS in production, e.g. https://petconnect-yourname.koyeb.app
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (Neon in production). Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/petconnect?sslmode=require

# Image uploads (Cloudinary). Leave unset to store uploads on local disk.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Real-time chat (Ably). Leave unset to fall back to 3-second polling.
# ABLY_API_KEY=appid.keyid:secret

# Optional
# SENTRY_DSN=
# DEMO_LOGIN_ENABLED=True
